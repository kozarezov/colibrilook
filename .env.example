# Экспортировать переменные в окружение процесса. Файл .env сам по себе не читается.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DATABASE_PATH=/srv/colibri/data/db.sqlite3
# Для MySQL (requirements-hosting.txt):
# DATABASE_ENGINE=mysql
# DATABASE_NAME=your_database
# DATABASE_USER=your_database_user
# DATABASE_PASSWORD=your_database_password
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# Только за прокси, который перезаписывает X-Forwarded-Proto:
# DJANGO_TRUST_PROXY_SSL=1
# Необязательный JSON-файл переменных вне публичной папки, права 600:
# DJANGO_ENV_FILE=/private/path/production.json
